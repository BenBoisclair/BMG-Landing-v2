---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import ProjectHero from '../../../components/sections/ProjectHero.astro';
import ProjectGrid from '../../../components/sections/ProjectGrid.astro';
import { useI18n } from '../../../i18n/utils';
import { getSiteSettings } from '../../../lib/queries/siteSettings';
import { pageHeroImage } from '../../../lib/sanityImage';

const { lang, t } = useI18n(Astro.url);
const siteSettings = await getSiteSettings();
const heroImageUrl = siteSettings?.projectsPageHeroImage
  ? pageHeroImage(siteSettings.projectsPageHeroImage)
  : undefined;
---

<BaseLayout
  title={`${t.project.title} | ${t.meta.title}`}
  description={t.meta.description}
  lang={lang}
>
  <Header pageType="project" />

  <main>
    <ProjectHero backgroundImage={heroImageUrl} />
    <ProjectGrid />
  </main>

  <Footer />
</BaseLayout>
