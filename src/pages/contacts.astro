---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ContactPageHero from '../components/sections/ContactPageHero.astro';
import Contact from '../components/sections/Contact.astro';
import { useI18n } from '../i18n/utils';
import { getSiteSettings } from '../lib/queries/siteSettings';
import { pageHeroImage } from '../lib/sanityImage';

const { lang, t } = useI18n(Astro.url);
const siteSettings = await getSiteSettings();
const heroImageUrl = siteSettings?.contactPageHeroImage
  ? pageHeroImage(siteSettings.contactPageHeroImage)
  : undefined;
---

<BaseLayout
  title={`${t.contactPage.title} | ${t.meta.title}`}
  description={t.contact.description}
  lang={lang}
>
  <Header pageType="process" />

  <main>
    <ContactPageHero backgroundImage={heroImageUrl} />
    <Contact />
  </main>

  <Footer />
</BaseLayout>
