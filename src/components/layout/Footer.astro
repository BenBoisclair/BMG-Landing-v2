---
import { useI18n, getLocalizedPath } from '../../i18n/utils';

const { t, lang } = useI18n(Astro.url);
const currentYear = new Date().getFullYear();

// Generate localized paths for legal pages
const privacyPath = getLocalizedPath(lang, '/privacy-policy');
const termsPath = getLocalizedPath(lang, '/terms-conditions');
---

<footer class="bg-bmg-footer text-gray-400 py-6">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="flex flex-wrap justify-center md:justify-start gap-2 text-sm">
        <a href={privacyPath} class="hover:text-white transition-colors">{t.footer.privacyPolicy}</a>
        <span>|</span>
        <a href={termsPath} class="hover:text-white transition-colors">{t.footer.termsConditions}</a>
        <span>|</span>
        <span>{t.footer.copyright} &copy; {currentYear} {t.footer.allRightsReserved}</span>
      </div>
      <div class="text-sm font-medium text-gray-300">
        {t.footer.companyName}
      </div>
    </div>
  </div>
</footer>
