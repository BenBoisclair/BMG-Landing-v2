---
import { getSiteSettings } from '../../lib/queries/siteSettings';
import { urlFor } from '../../lib/sanityImage';
import { parseVideoUrl } from '../../lib/videoUtils';

// Fetch site settings with error handling
let siteSettings = null;
try {
  siteSettings = await getSiteSettings();
} catch (error) {
  console.error('Failed to fetch site settings:', error);
}

// Compute video URL (priority: uploaded > external)
const rawVideoUrl = siteSettings?.heroVideoUrl || siteSettings?.heroVideoExternalUrl;
const videoInfo = parseVideoUrl(rawVideoUrl);

// Poster fallback
const posterUrl = siteSettings?.heroPoster
  ? urlFor(siteSettings.heroPoster).width(1920).height(1080).format('webp').url()
  : '/images/Landing/HeroSection/background_1.png';
---

<section id="home" class="relative h-screen min-h-[600px] max-h-[800px] pt-20 lg:pt-24">
  <!-- Background Video/Image -->
  <div class="absolute inset-0 z-0 overflow-hidden">
    {videoInfo.type === 'youtube' || videoInfo.type === 'vimeo' ? (
      <div id="hero-video-container" data-video-type={videoInfo.type} class="relative w-full h-full">
        {/* Poster fallback (shows if iframe fails to load) */}
        <img
          src={posterUrl}
          alt=""
          class="absolute inset-0 w-full h-full object-cover"
          aria-hidden="true"
        />
        {/* Iframe overlays the poster with security attributes */}
        <iframe
          id="hero-iframe"
          src={videoInfo.embedUrl}
          class="absolute top-1/2 left-1/2 w-[120%] h-[120%] -translate-x-1/2 -translate-y-1/2 pointer-events-none border-0"
          allow="autoplay; fullscreen"
          sandbox="allow-scripts allow-same-origin"
          loading="lazy"
          referrerpolicy="no-referrer"
          title="Hero background video"
          aria-hidden="true"
        />
      </div>
    ) : videoInfo.type === 'direct' ? (
      <div id="hero-video-container" data-video-type="direct" class="relative w-full h-full">
        <video
          id="hero-video"
          autoplay
          muted
          loop
          playsinline
          class="w-full h-full object-cover"
          poster={posterUrl}
          aria-hidden="true"
        >
          <source src={videoInfo.directUrl} />
        </video>
      </div>
    ) : (
      <img
        src={posterUrl}
        alt=""
        class="w-full h-full object-cover"
        aria-hidden="true"
      />
    )}
    <!-- Overlay -->
    <div class="absolute inset-0 bg-map-blue/20"></div>
  </div>

  {(videoInfo.type === 'youtube' || videoInfo.type === 'direct') && (
    <button
      id="hero-mute-toggle"
      type="button"
      class="absolute bottom-6 right-6 z-10 w-10 h-10 flex items-center justify-center bg-black/40 hover:bg-black/60 rounded-full backdrop-blur-sm transition-colors cursor-pointer"
      aria-label="Unmute video"
    >
      {/* Muted icon (visible by default) */}
      <svg id="icon-muted" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707A1 1 0 0112 5.586v12.828a1 1 0 01-1.707.707L5.586 15z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2" />
      </svg>
      {/* Unmuted icon (hidden by default) */}
      <svg id="icon-unmuted" class="w-5 h-5 text-white hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707A1 1 0 0112 5.586v12.828a1 1 0 01-1.707.707L5.586 15z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072M18.364 5.636a9 9 0 010 12.728" />
      </svg>
    </button>
  )}
</section>

<script>
  const btn = document.getElementById('hero-mute-toggle');
  const container = document.getElementById('hero-video-container');
  if (btn && container) {
    const videoType = container.dataset.videoType;
    const iconMuted = document.getElementById('icon-muted');
    const iconUnmuted = document.getElementById('icon-unmuted');
    let isMuted = true;

    btn.addEventListener('click', () => {
      isMuted = !isMuted;

      if (videoType === 'direct') {
        const video = document.getElementById('hero-video') as HTMLVideoElement | null;
        if (video) {
          video.muted = isMuted;
          if (!isMuted) video.play().catch(() => {});
        }
      } else if (videoType === 'youtube') {
        const iframe = document.getElementById('hero-iframe') as HTMLIFrameElement | null;
        if (iframe?.contentWindow) {
          const func = isMuted ? 'mute' : 'unMute';
          iframe.contentWindow.postMessage(
            JSON.stringify({ event: 'command', func, args: '' }),
            'https://www.youtube-nocookie.com'
          );
        }
      }

      // Toggle icons
      iconMuted?.classList.toggle('hidden', !isMuted);
      iconUnmuted?.classList.toggle('hidden', isMuted);
      btn.setAttribute('aria-label', isMuted ? 'Unmute video' : 'Mute video');
    });
  }
</script>
